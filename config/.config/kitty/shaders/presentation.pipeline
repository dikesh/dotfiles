startgroup
    animation_toggle user:presentation
    shaders spotlight
endgroup

# Smooth orange trail during ordinary cursor movement.
startgroup
    animation_start cursor-trail-move
    animation_stop cursor-trail-stop
    shaders cursor-trail-motion-blur
endgroup

# Default lightning only on Kitty tab/pane switches. A subsequent move or input
# stops it; a simultaneous context-switch start takes precedence.
startgroup
    animation_start tab-change | window-focus-in
    animation_stop 140 | cursor-trail-move | cursor-trail-stop | user-activity | os-window-focus-out
    shaders cursor-trail-lightning
endgroup
